# Local development only. Never commit actual credentials.
MONGO_URI=mongodb://127.0.0.1:27017/eoapp_dev
PORT=5000
CORS_ORIGINS=http://localhost:8080
# Off by default: inquiries are saved; no email is attempted.
SMTP_ENABLED=false
SMTP_HOST=smtp.example.invalid
SMTP_PORT=465
SMTP_USER=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_ROTATED_SMTP_PASSWORD
SMTP_FROM=inquiries@example.invalid
SMTP_TO=approved-team@example.invalid

# Replace all example.invalid/REPLACE_WITH values before enabling SMTP.

# Staff inbox is disabled until accounts and institution mappings are provisioned.
STAFF_ENABLED=false
# Keep true in production. Local HTTP only: set NODE_ENV=development and false.
STAFF_COOKIE_SECURE=true

# Direct API: 0. Only use 1 behind the private, header-overwriting Docker edge.
TRUST_PROXY_HOPS=0
